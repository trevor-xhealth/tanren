DATABASE_URL=postgres://tanren:tanren@postgres:5432/tanren
VAULT_ADDR=http://vault:8200
VAULT_HOST_ADDR=http://localhost:18200
VAULT_TOKEN=dev-root-token
ORCHESTRATOR_PORT=3100
DASHBOARD_PORT=3000
# CANONICAL orchestrator public base URL. The single name for the orchestrator's
# reachable address — the OAuth redirect base, the CLI target, and the dashboard's
# App-install href all read it. (Collapsed from the old TANREN_ORCHESTRATOR_URL /
# TANREN_ORCHESTRATOR_PUBLIC_URL names.)
TANREN_PUBLIC_BASE_URL=http://localhost:3100
# Host port the dashboard is published on (in-container port stays 3000).
# Uncomment + change if host :3000 is already taken. Defaults to 3000.
# DASHBOARD_HOST_PORT=3000

# The secret-store backend (REQUIRED; no implicit default). `vault` is the only
# backend today. Boot fails loud if unset (engine/contracts/secretStoreFactory.ts).
TANREN_SECRET_STORE=vault

# Bearer token the orchestrator/worker use to call the allocator sidecar
# (`/allocate` + `/release`). REQUIRED — no `"dev"` fallback; a blank value fails
# hard rather than silently accepting `Bearer dev`. Dev compose uses `dev`.
TANREN_ALLOCATOR_TOKEN=dev

# Set Secure on session cookies (prod-like). "0"/"1". Leave 0 for local http dev;
# compose.prod.yml sets "1". TANREN_DEV_LOGIN is also refused when this is "1"
# (defense-in-depth); the primary refuse is NODE_ENV=production / TANREN_ENV=prod.
# TANREN_COOKIE_SECURE=0

# Push base URL for ntfy milestone alerts. Defaults to http://ntfy:80 (the compose
# ntfy service). Override to e.g. https://ntfy.sh for the public service.
# TANREN_NTFY_BASE_URL=http://ntfy:80

# CANONICAL GitHub App install URL + the Vault ref of the App credential. The
# orchestrator's `/auth/github-app/*` install route mounts ONLY when BOTH are set;
# the dashboard reads the install URL from the orchestrator's /auth/providers.
# (Collapsed from the dashboard's old TANREN_GITHUB_APP_URL name.)
# TANREN_GITHUB_APP_INSTALL_URL=https://github.com/apps/tanren/installations/new
# TANREN_GITHUB_APP_CREDENTIAL_REF=credential/github/app

# Control-plane INTERNAL mTLS listener (the `/internal/*` claim + run-state-write
# surface). The listener starts ONLY when all three cert paths are set. Port
# defaults to 3110. Dev single-process / in-process worker needs none of these.
# TANREN_INTERNAL_MTLS_PORT=3110
# TANREN_INTERNAL_TLS_CERT=/etc/tanren/mtls/server.crt
# TANREN_INTERNAL_TLS_KEY=/etc/tanren/mtls/server.key
# TANREN_INTERNAL_TLS_CA=/etc/tanren/mtls/ca.crt
# Host port the internal mTLS listener is published on (in-container stays 3110).
# Uncomment + change if host :3110 is taken (e.g. a second apex stack on the same
# host); or use the bulk-shift TANREN_PORT_OFFSET. Defaults to 3110.
# TANREN_INTERNAL_MTLS_HOST_PORT=3110

# Allocator runtime knobs (validated by services/allocator/src/envSchema.ts).
# ALLOCATOR_PORT=3200
# Host port the allocator sidecar is published on (in-container stays 3200).
# Uncomment + change if host :3200 is taken (e.g. a second apex stack on the same
# host); or use the bulk-shift TANREN_PORT_OFFSET. Defaults to 3200.
# TANREN_ALLOCATOR_HOST_PORT=3200
# Max wall-clock hours before the sweeper reclaims an abandoned runner. Must be
# > 0 (a <= now reaper threshold would reap every active runner). Default 6.
# TANREN_MAX_RUN_HOURS=6
# TANREN_ALLOCATOR_NETWORK=tanren_default
# TANREN_ALLOCATOR_SSH_HOSTNAME_TEMPLATE={container}
# TANREN_ALLOCATOR_SWEEPER_INTERVAL_MS=60000
# PUBLIC key line the runner authorizes for the orchestrator's SSH (safe in env).
# TANREN_RUNNER_AUTHORIZED_KEY=

# DEV-ONLY sign-in escape hatch. Copy this file to `.env` (gitignored), then
# `just up-dev`. Compose auto-reads `.env` in the repo root for the ${VAR:-}
# defaults in compose.dev.yml. Both default OFF when unset, so CI's open smoke
# flow is unaffected. compose.prod.yml never reads TANREN_DEV_LOGIN and sets
# NODE_ENV=production so the hatch is refused even if the flag leaks in.
#
# TANREN_DEV_LOGIN registers the orchestrator's local_dev identity provider and
# surfaces a one-click "sign in (dev)" button in the dashboard, so you land
# authenticated without registering a GitHub OAuth app. Honored only with a
# POSITIVE explicit-dev marker (NODE_ENV ∈ {development,dev,test} or
# TANREN_ENV ∈ {dev,development,test}) and TANREN_COOKIE_SECURE ≠ 1. An unset
# profile + cookie-secure-off is NOT enough. compose.dev.yml sets TANREN_ENV=dev.
# TANREN_REQUIRE_AUTH gates the dashboard so the sign-in flow is actually driven.
# In production profiles (NODE_ENV=production / TANREN_ENV=prod) auth defaults ON
# when this is unset (fail-closed); explicit "0" remains the e2e opt-out.
# See docs/operator-guide/auth.md.
TANREN_ENV=dev
TANREN_DEV_LOGIN=1
TANREN_REQUIRE_AUTH=1

# Run-executor worker (P3-0001): when set, the orchestrator dequeues queued runs
# and drives them end-to-end (plan→write→gate→check→audit→PR→CI→review→merge).
# Required for real-loop manual validation; OFF by default so CI smoke/tests are
# unaffected. How many runs may be in flight is NOT an env var: it is the governed
# `allocator.concurrency` config knob (org default, per-project override).
TANREN_RUN_WORKER=1

# OIDC identity provider (additive, opt-in). The orchestrator registers the
# `oidc` provider only when issuer + client id + client secret are all set;
# leaving them unset keeps GitHub OAuth / dev-login behavior unchanged.
#
# TANREN_OIDC_PRESET=authentik is the turnkey homelab path: it fills Authentik's
# standard claim mapping (preferred_username -> login, name -> display name,
# groups -> orgs) and the `openid profile email groups` scopes by default, so you
# only supply issuer + client id/secret. Explicit TANREN_OIDC_*_CLAIM / _SCOPES
# envs still override the preset. See docs/operator-guide/oidc-authentik.md.
# TANREN_OIDC_PRESET=authentik
# TANREN_OIDC_ISSUER=https://authentik.home.lan/application/o/tanren/
# TANREN_OIDC_CLIENT_ID=
# TANREN_OIDC_CLIENT_SECRET=

# PERSISTENT host dir for dev RUNTIME artifacts that must survive a whole
# (multi-hour) run: the runner identity key (+ .pub + known_hosts) and the mTLS
# material. Do NOT point this at /tmp — systemd-tmpfiles cleans /tmp out from under
# a long run, deleting the key so the worker container can no longer restart. The
# justfile exports this default for every `just` recipe; it is set here so raw
# `docker compose -f compose.dev.yml ...` (outside `just`) also resolves the paths.
# ${HOME} is expanded by compose. Override to relocate the dir.
TANREN_RUNTIME_DIR=${HOME}/.config/tanren/runtime
