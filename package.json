{
  "name": "tanren",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.1.0",
  "scripts": {
    "build": "turbo run build",
    "check": "just ci",
    "check:answerer-schema-drift": "node scripts/answerer-schema-export.mjs --check",
    "check:contract-schema-drift": "node scripts/contract-schema-export.mjs --check",
    "check:dashboard-types-drift": "node scripts/gen-dashboard-types.mjs --check",
    "check:integration-schema-bundle-drift": "node scripts/gen-integration-schema-bundle.mjs --check",
    "check:rv-read-compat": "node scripts/rv-read-compat.mjs --check",
    "check:integration-read-compat": "node scripts/integration-read-compat.mjs --check",
    "check:architecture": "node scripts/check-architecture.mjs",
    "check:fast": "just fast-check",
    "check:schema-drift": "bash scripts/check-schema-drift.sh",
    "check:state-drift": "node scripts/generate-state-checks.mjs --check",
    "check:event-drift": "node scripts/generate-event-type-seed.mjs --check",
    "check:event-migration-drift": "node scripts/check-event-type-migrations.mjs",
    "check:env-reads": "node scripts/lint/env-read-whitelist.mjs",
    "check:knip": "knip",
    "check:mutation": "stryker run",
    "check:no-pg-as-date": "node scripts/lint/no-pg-as-date.mjs",
    "check:spelling": "cspell --no-progress \"**/*.{ts,tsx,js,mjs,md,yml,yaml}\"",
    "check:types-lint": "oxlint --type-aware -c oxlintrc.typeaware.json services/orchestrator/src services/allocator/src services/dashboard/src db/src cli/src",
    "codegen:answerer-schemas": "node scripts/answerer-schema-export.mjs",
    "codegen:contract-schemas": "node scripts/contract-schema-export.mjs",
    "codegen:dashboard-types": "node scripts/gen-dashboard-types.mjs",
    "codegen:integration-schema-bundle": "node scripts/gen-integration-schema-bundle.mjs",
    "codegen:rv-read-compat": "node scripts/rv-read-compat.mjs",
    "codegen:integration-read-compat": "node scripts/integration-read-compat.mjs",
    "codegen:state": "node scripts/generate-state-checks.mjs",
    "codegen:events": "node scripts/generate-event-type-seed.mjs",
    "compose:config": "docker compose -f compose.dev.yml config --quiet",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "format": "oxfmt --write \"**/*.{ts,tsx,js,mjs,json,md,yml,yaml}\"",
    "format:check": "node scripts/format-check.mjs",
    "lint": "oxlint -c oxlintrc.json . && node scripts/lint/env-read-whitelist.mjs",
    "test": "vitest run --coverage",
    "test:no-coverage": "vitest run",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "@stryker-mutator/core": "9.6.1",
    "@stryker-mutator/vitest-runner": "9.6.1",
    "@types/node": "^25.9.1",
    "@types/pg": "^8.20.0",
    "@types/ssh2": "1.15.5",
    "@vitest/coverage-v8": "4.1.8",
    "cspell": "^10.0.1",
    "drizzle-kit": "^0.31.10",
    "knip": "^6.15.0",
    "lefthook": "2.1.9",
    "oxc-parser": "0.133.0",
    "oxfmt": "^0.53.0",
    "oxlint": "^1.68.0",
    "oxlint-tsgolint": "^0.23.0",
    "tsx": "^4.22.4",
    "turbo": "^2.9.16",
    "typescript": "7.0.2",
    "vitest": "^4.1.8"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "cpu-features",
      "esbuild",
      "ssh2"
    ]
  }
}
