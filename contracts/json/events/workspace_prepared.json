{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "repoUrl": {
      "type": "string"
    },
    "runnerId": {
      "type": "string"
    },
    "targetBranch": {
      "type": "string"
    },
    "toolchain": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "declared": {
            "type": "string"
          },
          "declaredIn": {
            "type": "string"
          },
          "resolved": {
            "type": "string"
          },
          "tool": {
            "type": "string"
          },
          "versionDeclared": {
            "type": "boolean"
          }
        },
        "required": [
          "tool",
          "declared",
          "resolved",
          "declaredIn",
          "versionDeclared"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "workspacePath": {
      "type": "string"
    }
  },
  "required": [
    "workspacePath"
  ],
  "type": "object",
  "x-tanren-schema-id": "tanren.event.workspace.prepared"
}
